# Variables para infra/docker-compose.yml
# Copiar a infra/.env y ajustar valores. El archivo .env no se versiona.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=support_desk
# Puerto expuesto en el host (cambiar si 5432 ya esta ocupado)
POSTGRES_PORT=5432

# Backend (servicio dockerizado, HU-4.2)
JWT_SECRET=cambia-esto-por-un-secreto-seguro
JWT_EXPIRES_IN=1d
# Origen del frontend para CORS
ALLOWED_ORIGINS=http://localhost:5173
# Puerto de la API expuesto en el host
BACKEND_PORT=3000

# DATABASE_URL para el backend
#
# Si el backend corre en el HOST (npm run dev) y postgres en Docker:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/support_desk?schema=public"
#   (esta es la URL que va en backend/.env)
#
# Si el backend corre DENTRO de Docker Compose, el host es el nombre
# del servicio ("postgres") en lugar de "localhost":
#   DATABASE_URL="postgresql://postgres:postgres@postgres:5432/support_desk?schema=public"
#   (el compose ya la construye automaticamente con estas variables)
