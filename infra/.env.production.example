# Variables de PRODUCCION para infra/docker-compose.prod.yml
# Copiar a infra/.env en el VPS y completar con valores REALES.
# El archivo .env real NO se versiona (ver .gitignore).

# PostgreSQL — usar un password fuerte
POSTGRES_USER=support_desk
POSTGRES_PASSWORD=CAMBIA_ESTO_password_fuerte
POSTGRES_DB=support_desk

# Backend
# Generar el secreto con: openssl rand -hex 32
JWT_SECRET=CAMBIA_ESTO_genera_con_openssl_rand_hex_32
JWT_EXPIRES_IN=1d

# Dominio(s) del frontend permitidos por CORS (sin barra final, separados por coma)
ALLOWED_ORIGINS=https://tu-dominio.com

# Puerto HTTP que expone Nginx en el host (80 por defecto).
# Solo cambiar para pruebas locales si el 80 esta ocupado.
HTTP_PORT=80
